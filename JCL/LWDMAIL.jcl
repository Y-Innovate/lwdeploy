//LWDMAIL  JOB 'LWD MAIL ADDR',CLASS=A,MSGCLASS=A,USER={{SCHEDUSER}}
//*
//* The daily refresh of LWD's email addresses (S4 step 5, M8,
//* docs/11-iteration-7.md): RACF WORKATTR WAEMAIL of every userid
//* LWD knows into USERS.EMAIL, where the notification mails (S5) go.
//* Schedule it once a day with any workload scheduler, and run it
//* once by hand before trying mail. Under {{SCHEDUSER}}, as LWDTICK:
//* READ on FACILITY IRR.RADMIN.LISTUSER and IRR.LISTUSER, and on
//* FIELD USER.WORKATTR.WAEMAIL (JCL/RACF), READ on {{LOADLIB}}
//* and {{EXECLIB}}.
//* MAILLIST (LWDM960 LIST): the userids of USERS.
//* MAILGET (REXX LWDR961): their WAEMAIL, with IRRXUTIL.
//* MAILLOAD (LWDM960 LOAD): the addresses into DB2; a userid
//* IRRXUTIL failed for keeps its address.
//* RC 0 = all OK; 8 = see SYSOUT and SYSTSPRT. The next run tries
//* again.
//*
//MAILLIST EXEC PGM=IKJEFT1B
//STEPLIB  DD DISP=SHR,DSN={{LOADLIB}}
//         DD DISP=SHR,DSN={{DB2SSHLQ}}.SDSNEXIT
//         DD DISP=SHR,DSN={{DB2HLQ}}.SDSNLOAD
//USERLIST DD DSN=&&USERLIST,DISP=(NEW,PASS),SPACE=(TRK,(5,5),RLSE),
//            RECFM=FB,LRECL=80
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM({{DB2SSID}})
 RUN PROGRAM(LWDM960) PLAN({{DB2PLAN}}) PARMS('LIST')
 END
/*
//*
//GETCHK   IF (MAILLIST.RC = 0) THEN
//MAILGET  EXEC PGM=IKJEFT1B,PARM='%LWDR961'
//SYSEXEC  DD DISP=SHR,DSN={{EXECLIB}}
//USERLIST DD DSN=&&USERLIST,DISP=(OLD,DELETE)
//USERMAIL DD DSN=&&USERMAIL,DISP=(NEW,PASS),SPACE=(TRK,(15,15),RLSE),
//            RECFM=FB,LRECL=300
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD DUMMY
//*
//LOADCHK  IF (MAILGET.RC = 0) THEN
//MAILLOAD EXEC PGM=IKJEFT1B
//STEPLIB  DD DISP=SHR,DSN={{LOADLIB}}
//         DD DISP=SHR,DSN={{DB2SSHLQ}}.SDSNEXIT
//         DD DISP=SHR,DSN={{DB2HLQ}}.SDSNLOAD
//USERMAIL DD DSN=&&USERMAIL,DISP=(OLD,DELETE)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *
 DSN SYSTEM({{DB2SSID}})
 RUN PROGRAM(LWDM960) PLAN({{DB2PLAN}}) PARMS('LOAD')
 END
/*
//LOADEND  ENDIF
//GETEND   ENDIF
