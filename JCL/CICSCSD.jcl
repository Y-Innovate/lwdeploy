//LWDCSD   JOB 'LWD CSD DEFS',CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID
//*
//* DELCSD: Delete the group and take it out of the list, so UPDCSD
//* defines everything anew (DFHCSDUP DEFINE doesn't replace). On the
//* first run the group doesn't exist yet: RC 8 here is expected, and
//* UPDCSD runs regardless. Installed resources are not affected
//* until the group is installed again.
//*
//DELCSD  EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DELETE GROUP({{CICSGRP}})
REMOVE GROUP({{CICSGRP}}) LIST({{CICSLST}})
//SYSPRINT  DD SYSOUT=*
//*
//UPDCSD  EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DEFINE TRANSACTION({{CICSTXN_PUBLIC}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD PUBLIC: WEB UI FILES')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_PUBLIC}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD PUBLIC DB2ENTRY')
       TRANSID({{CICSTXN_PUBLIC}}) PLAN({{DB2PLAN_PUBLIC}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_USER}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD USER TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_USER}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD USER DB2ENTRY')
       TRANSID({{CICSTXN_USER}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_ADMIN}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD ADMIN TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_ADMIN}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD ADMIN DB2ENTRY')
       TRANSID({{CICSTXN_ADMIN}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_SUBMIT}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD JOB SUBMISSION')
       PROGRAM(LWDC910)
DEFINE DB2ENTRY({{CICSTXN_SUBMIT}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD JOB SUBMISSION DB2ENTRY')
       TRANSID({{CICSTXN_SUBMIT}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_SCHED}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD SCHEDULER TICK')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_SCHED}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD SCHEDULER DB2ENTRY')
       TRANSID({{CICSTXN_SCHED}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_RESULT}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD RESULT STEP')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_RESULT}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD RESULT STEP DB2ENTRY')
       TRANSID({{CICSTXN_RESULT}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE LIBRARY({{CICSLIB}}) GROUP({{CICSGRP}})
       DESCRIPTION('LWD LOAD LIBRARY')
       DSNAME01({{LOADLIB}})
ADD G({{CICSGRP}}) LI({{CICSLST}})
//CBDOUT    DD SYSOUT=*
//SYSUT1    DD UNIT=SYSDA,SPACE=(1024,(100,100))
//SYSPRINT  DD SYSOUT=*
