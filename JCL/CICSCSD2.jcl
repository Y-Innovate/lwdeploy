//LWDCSD   JOB 'LWD CSD DEFS',CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID
//*
//* DELCSD: Delete both groups and take them out of their lists, so
//* UPDCSDW and UPDCSDA define everything anew (DFHCSDUP DEFINE
//* doesn't replace). On the first run the groups don't exist yet:
//* RC 8 here is expected, and the other steps run regardless.
//* Installed resources are not affected until the groups are
//* installed again.
//*
//DELCSD  EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DELETE GROUP({{CICSGRPW}})
REMOVE GROUP({{CICSGRPW}}) LIST({{CICSLSTW}})
DELETE GROUP({{CICSGRPA}})
REMOVE GROUP({{CICSGRPA}}) LIST({{CICSLSTA}})
//SYSPRINT  DD SYSOUT=*
//*
//UPDCSDW EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DEFINE TRANSACTION({{CICSTXN_PUBLIC}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD PUBLIC: WEB UI FILES')
       PROGRAM(DFHWBA)
DEFINE TRANSACTION({{CICSTXN_USER}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD USER TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE TRANSACTION({{CICSTXN_ADMIN}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD ADMIN TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE TRANSACTION({{CICSTXN_SCHED}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD SCHEDULER TICK')
       PROGRAM(DFHWBA)
DEFINE TRANSACTION({{CICSTXN_RESULT}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD RESULT STEP')
       PROGRAM(DFHWBA)
DEFINE LIBRARY({{CICSLIB}}) GROUP({{CICSGRPW}})
       DESCRIPTION('LWD LOAD LIBRARY')
       DSNAME01({{LOADLIB}})
DEFINE PROGRAM(LWDC001) GROUP({{CICSGRPW}})
       DESCRIPTION('CTF WRAPPER PROGRAM')
       DATALOCATION(ANY) EXECKEY(USER) CONCURRENCY(THREADSAFE)
       DYNAMIC(YES)
DEFINE PROGRAM(LWDC002) GROUP({{CICSGRPW}})
       DESCRIPTION('CTF WRAPPER PROGRAM')
       DATALOCATION(ANY) EXECKEY(USER) CONCURRENCY(THREADSAFE)
